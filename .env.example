# ==============================================================================
# CogniShell Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and modify the values for your local environment.
# 
# NOTE for Windows + Multipass Users:
# If you run the Go application inside a Docker container within a Multipass VM,
# 'localhost' will refer to the container or VM itself, not the Windows host.
# In that case, use your Windows LAN IP address (e.g., 192.168.X.X or 10.0.X.X) 
# for PROMETHEUS_URL, LOKI_URL, OLLAMA_URL, and DB_HOST.
# ==============================================================================

# Server Settings
APP_PORT=8080
ENVIRONMENT=development

# Infrastructure Service Endpoints
# Use host LAN IP if running inside VM/Docker, or localhost if running natively
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
OLLAMA_URL=http://localhost:11434

# HashiCorp Vault Configuration
VAULT_ADDR=http://localhost:8200
VAULT_ROLE_ID=your-vault-approle-role-id
VAULT_SECRET_ID=your-vault-approle-secret-id
VAULT_SECRET_PATH=secret/data/cognishell/dev

# GitHub Configuration
# Personal Access Token (PAT) needs repo scope to read scripts and create issues
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO_OWNER=your-github-username-or-org
GITHUB_REPO_NAME=your-scripts-repository-name

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=cognishell_admin
DB_PASSWORD=cognishell_password
DB_NAME=cognishell_db
DB_SSLMODE=disable

# Ephemeral Log Purge Configuration
# Run the database and Loki cleanup worker at specified intervals
# Dev settings: check every 1 minute and purge logs older than 5 minutes
# Prod settings: check every 1 hour (1h) and purge logs older than 30 days (720h)
PURGE_INTERVAL=1m
RETENTION_PERIOD=5m

# Alerting & ChatOps Notification Settings
# Supported values: teams | slack | none
NOTIFICATION_PROVIDER=none
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
